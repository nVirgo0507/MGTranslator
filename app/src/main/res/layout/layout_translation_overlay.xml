<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/translation_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Container where bounding box highlights and speech bubbles are drawn -->
    <FrameLayout
        android:id="@+id/translation_bubbles_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Subtle toast/banner when capture/OCR runs -->
    <TextView
        android:id="@+id/tv_capture_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="#D9000000"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:elevation="12dp"
        android:visibility="gone" />

</FrameLayout>
