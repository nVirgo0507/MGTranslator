<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/iv_bubble_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_floating_bubble"
        android:src="@drawable/ic_translate"
        android:scaleType="centerInside"
        android:contentDescription="Translate"
        android:elevation="6dp" />

    <!-- Badge indicating auto-reading status (Green when active) -->
    <View
        android:id="@+id/view_auto_badge"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_auto_badge"
        android:elevation="8dp"
        android:visibility="gone" />

</FrameLayout>
